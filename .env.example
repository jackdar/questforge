# Copy this file to .env and replace the password. Git ignores .env.
# Use only letters, numbers, "-" and "_" in the password, because it goes into a URL.

# Docker Compose uses these values to create the database.
POSTGRES_USER=questforge
POSTGRES_PASSWORD=replace-this-password
POSTGRES_DB=questforge

# "npm run dev" uses this URL to reach the database container from your machine. Start the database with "npm run db:dev".
DATABASE_URL=postgres://questforge:replace-this-password@localhost:5432/questforge

# "npm test" starts the database, then runs the database tests with this URL. The tests use temporary schemas and remove them after.
TEST_DATABASE_URL=postgres://questforge:replace-this-password@localhost:5432/questforge

# Set this to true when players reach the game over HTTPS, for example through Cloudflare.
# The browser then sends the login cookie only over HTTPS.
SECURE_COOKIES=false

# The address and port where nginx accepts connections on this machine.
# Keep 127.0.0.1 when the reverse proxy runs on this machine. Use 0.0.0.0 only when it runs on another machine.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Only for docker-compose.traefik.yml. Traefik routes requests for this domain to the game.
QUESTFORGE_DOMAIN=game.example.com
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=https
